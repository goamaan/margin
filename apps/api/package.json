{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lantern/api": "workspace:*",
    "@lantern/runtime": "workspace:*",
    "effect": "4.0.0-beta.66"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.3.0",
    "@types/bun": "^1.3.5",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
